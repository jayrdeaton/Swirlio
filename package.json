{
  "name": "swirlio",
  "version": "1.0.2",
  "private": true,
  "description": "An interactive kaleidoscope toy driven by touch, tilt, and gravity physics.",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "eas build",
    "build:web": "npm run verify && expo export -p web",
    "client": "expo start --dev-client",
    "doctor": "expo install --fix && npx expo-doctor@latest",
    "fingerprint:compare": "eas fingerprint:compare",
    "fix": "expo lint . --fix",
    "postinstall": "setup-skia-web",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "expo lint .",
    "reset": "expo start -c",
    "run": "eas build:run",
    "start": "expo start",
    "submit": "eas submit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc",
    "update": "eas update",
    "verify": "npm run lint && npm test && npm run typecheck"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@rific/auto-paper": "^0.13.4",
    "@rific/core": "^0.5.0",
    "@rific/drawer": "^0.8.2",
    "@rific/feedback-press": "^0.13.1",
    "@rific/splash-gate": "^0.2.3",
    "@rific/updater": "^0.7.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tastic/core": "^0.14.0",
    "@tastic/edge-guard": "^0.1.5",
    "@tastic/hud": "^0.25.1",
    "@tastic/sprites": "^0.2.1",
    "eslint-plugin-package-json": "^1.7.1",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.10",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.13.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.6.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
