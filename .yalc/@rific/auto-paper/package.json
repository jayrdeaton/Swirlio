{
  "name": "@rific/auto-paper",
  "version": "0.9.0",
  "description": "Adaptive react-native-paper theming: triadic palette from a seed color + system/light/dark appearance",
  "keywords": [
    "react-native",
    "expo",
    "react-native-paper",
    "md3",
    "material-you",
    "material-design",
    "theming",
    "dark-mode",
    "seed-color",
    "color-palette",
    "triadic",
    "adaptive-theme",
    "appearance"
  ],
  "homepage": "https://github.com/jayrdeaton/react-native-auto-paper#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/react-native-auto-paper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/react-native-auto-paper.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run lint && npm test && npm run build"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "expo-blur": ">=56.0.0",
    "expo-navigation-bar": ">=56.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0",
    "react-native-paper": ">=5.0.0",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-navigation-bar": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@reduxjs/toolkit": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "yalcSig": "9c2da9204b699c40e2c94950369e27a7"
}
